<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All articles</title>
    <link rel="stylesheet", type='text/css', href='/css/style.css'>
</head>
<body>
    <h1>All articles</h1>
    <% articlesArray.forEach(function(article) { %>
            <h3><%= article.title %></h3>
            <p> <%= article.text %></p>
        <% }); %>
</body>
</html>