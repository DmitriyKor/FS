doctype html
html
  head
    title Users catalogue
    link(rel="stylesheet", type='text/css', href='/css/style.css') 
  body
    header
      h1.main-header List of users
    main
        h2 Table
        table
            thead
                tr
                    th ID
                    th Name
                    th Email
            tbody
                each user in usersArray
                    tr
                        td= user.id
                        td= user.name
                        td= user.email
    footer
      p &copy; 2025 My Awesome Site